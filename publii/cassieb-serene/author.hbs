{{! Author archive page }}
{{> head}}
{{> header}}

<main id="main" class="archive-page">
  <div class="container">
    <header class="archive-header">
      <p class="section-eyebrow">Posts by</p>
      {{#author}}
      <h1>{{name}}</h1>
      {{#if description}}
      <p class="archive-lead">{{{description}}}</p>
      {{/if}}
      {{/author}}
    </header>

    <div class="archive-grid">
      {{#each posts}}
      <article class="archive-card">
        {{#featuredImage}}
          {{#if url}}
          <a class="note-photo" href="{{../url}}">
            <img src="{{url}}" {{lazyload "lazy"}} alt="{{alt}}" height="{{height}}" width="{{width}}">
          </a>
          {{/if}}
        {{/featuredImage}}
        <div class="note-body">
          <h3><a href="{{url}}">{{title}}</a></h3>
          <p>{{{excerpt}}}</p>
          <p class="note-meta"><time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">{{date createdAt}}</time></p>
        </div>
      </article>
      {{/each}}
    </div>
  </div>
</main>

{{> footer}}
