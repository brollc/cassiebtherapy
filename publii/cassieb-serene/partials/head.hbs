<!DOCTYPE html>
<html lang="{{ @website.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {{#if title}}
    <title>{{title}}</title>
  {{else}}
    <title>{{ @website.name }}</title>
  {{/if}}

  {{metaDescription}}
  {{metaRobots}}
  {{canonicalLink}}
  {{feedLink}}
  {{socialMetaTags}}
  {{{publiiHead}}}
  {{jsonLD}}

  {{#if @config.custom.faviconUpload}}
    <link rel="shortcut icon" href="{{ @config.custom.faviconUpload }}" type="image/png">
  {{else}}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Ccircle cx='20' cy='20' r='18' fill='%237fa8c9'/%3E%3Ccircle cx='20' cy='20' r='10' fill='none' stroke='%23faf8f4' stroke-width='2'/%3E%3Ccircle cx='20' cy='20' r='4' fill='%23faf8f4'/%3E%3C/svg%3E">
  {{/if}}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{css "style.css"}}">

  {{{@headCustomCode}}}
</head>
<body>

{{{@bodyCustomCode}}}
