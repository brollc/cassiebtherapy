{{!
  Cassie B Therapy — Publii homepage template.
  All visible content is edited in Publii under: Theme → Theme settings (Custom settings tabs).
}}
{{> head}}
{{> header}}

<main id="main">

  {{! ================= HERO ================= }}
  <section class="hero" id="home">
    <div class="hero-bg" aria-hidden="true">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
      <svg class="leaf-deco leaf-1" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 95C20 70 5 50 5 30 25 35 45 60 50 95zM50 95C80 70 95 50 95 30 75 35 55 60 50 95z" fill="var(--leaf-light)" opacity="0.5"/></svg>
      <svg class="leaf-deco leaf-2" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 95C20 70 5 50 5 30 25 35 45 60 50 95zM50 95C80 70 95 50 95 30 75 35 55 60 50 95z" fill="var(--moss)" opacity="0.4"/></svg>
    </div>

    <div class="container hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">{{ @config.custom.heroEyebrow }}</p>
        <h1 class="hero-title">{{ @config.custom.heroTitle }}</h1>
        <p class="hero-subtitle">{{ @config.custom.heroSubtitle }}</p>
        <div class="hero-actions">
          <a href="{{ @website.baseUrl }}#contact" class="btn btn-primary">{{ @config.custom.heroPrimaryBtnLabel }}</a>
          <a href="{{ @website.baseUrl }}about/" class="btn btn-ghost">{{ @config.custom.heroSecondaryBtnLabel }}</a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="hero-art-circle"></div>
        <div class="hero-art-frame">
          <div class="hero-art-photo"></div>
        </div>
        <div class="hero-art-badge">
          <span class="badge-emoji">{{ @config.custom.heroBadgeEmoji }}</span>
          <span class="badge-text">{{{ @config.custom.heroBadgeText }}}</span>
        </div>
      </div>
    </div>

    <div class="hero-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 110" preserveAspectRatio="none"><path d="M0 70 C 240 110 480 20 720 50 C 960 80 1200 110 1440 60 L1440 110 L0 110 Z" fill="var(--cream)"/></svg>
    </div>
  </section>

  {{! ================= ABOUT ================= }}
  <section class="about" id="about">
    <div class="container about-grid">
      <div class="about-art" aria-hidden="true">
        <div class="about-art-frame">
          <div class="about-art-photo"></div>
        </div>
        <div class="about-art-stamp">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true"><path d="M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 19.4 7.2 16.9l.9-5.4L4.2 7.7l5.4-.8L12 2z" fill="var(--cream)"/></svg>
          {{ @config.custom.aboutStampText }}
        </div>
      </div>
      <div class="about-content">
        <p class="section-eyebrow">{{ @config.custom.aboutEyebrow }}</p>
        <p class="about-intro"><em>{{ @config.custom.aboutIntro }}</em></p>
        <p>{{ @config.custom.aboutP1 }}</p>
        <p>{{ @config.custom.aboutP2 }}</p>
        {{#if @config.custom.aboutGlad}}
        <p class="about-glad">{{ @config.custom.aboutGlad }}</p>
        {{/if}}
        {{#if @config.custom.aboutLinkLabel}}
        <p>
          <a class="about-link" href="{{ @website.baseUrl }}about/">{{ @config.custom.aboutLinkLabel }}</a>
        </p>
        {{/if}}
        <div class="about-creds">
          {{#each @config.custom.aboutCreds}}
          <div class="cred"><span class="cred-icon" aria-hidden="true">{{icon}}</span><div><strong>{{title}}</strong><span>{{subtitle}}</span></div></div>
          {{/each}}
        </div>
      </div>
    </div>
  </section>

  {{! ================= THE WORK ================= }}
  <section class="workthrough" id="the-work">
    <div class="container">
      <div class="workthrough-head">
        <p class="section-eyebrow eyebrow-light">{{ @config.custom.workEyebrow }}</p>
        <h2 class="workthrough-title">{{{ @config.custom.workTitle }}}</h2>
      </div>
      <p class="workthrough-intro">
        {{{ @config.custom.workIntro }}}
      </p>

      <p class="workthrough-more">
        {{ @config.custom.workMoreText }}
        {{#if @config.custom.workDiveLabel}}<a href="{{ @website.baseUrl }}the-work/">{{ @config.custom.workDiveLabel }}</a>{{/if}}
      </p>

      <p class="workthrough-label">{{ @config.custom.workBeliefsLabel }}</p>
      <ul class="workthrough-list">
        {{#each @config.custom.workBeliefs}}
        <li>{{text}}</li>
        {{/each}}
      </ul>
      <a href="{{ @website.baseUrl }}#contact" class="btn btn-primary">{{ @config.custom.workCtaLabel }}</a>
    </div>
  </section>

  {{! ================= NUTS AND BOLTS ================= }}
  <section class="nutsbolts" id="nuts-and-bolts">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow">{{ @config.custom.nutsBoltsEyebrow }}</p>
        <h2>{{{ @config.custom.nutsBoltsTitle }}}</h2>
      </div>
      <div class="nutsbolts-grid">
        <div class="nutsbolts-basics">
          <ul class="nutsbolts-basics-list">
            <li><strong>{{ @config.custom.nutsBoltsLicense }}</strong></li>
            <li>{{ @config.custom.nutsBoltsDegree }}</li>
          </ul>
        </div>
        <div class="nutsbolts-card">
          <h3>🧩 {{ @config.custom.nutsBoltsTrainingsLabel }}</h3>
          <ul class="nutsbolts-list">
            {{#each @config.custom.nutsBoltsTrainings}}
            <li>{{title}}</li>
            {{/each}}
          </ul>
        </div>
        <div class="nutsbolts-card">
          <h3>💞 {{ @config.custom.nutsBoltsCouplesLabel }}</h3>
          <ul class="nutsbolts-list">
            {{#each @config.custom.nutsBoltsCouples}}
            <li>{{title}}</li>
            {{/each}}
          </ul>
        </div>
      </div>
      <p class="nutsbolts-note">
        {{ @config.custom.nutsBoltsLearnerNote }}
      </p>
    </div>
  </section>

  {{! ================= GET STARTED (3 STEPS) ================= }}
  <section class="steps" id="get-started">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow">{{ @config.custom.stepsEyebrow }}</p>
        <h2>{{ @config.custom.stepsTitle }}</h2>
        <p class="section-lead">{{ @config.custom.stepsLead }}</p>
      </div>

      <div class="steps-grid">
        {{#each @config.custom.stepsItems}}
        <div class="step">
          <span class="step-num">{{number}}</span>
          <h3>{{title}}</h3>
          <p>{{text}}</p>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  {{! ================= SPECIALTIES ================= }}
  <section class="specialties" id="services">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow">{{ @config.custom.specialtiesEyebrow }}</p>
        <h2>{{ @config.custom.specialtiesTitle }}</h2>
        <p class="section-lead">{{ @config.custom.specialtiesLead }}</p>
      </div>

      <div class="specialties-grid">
        {{#each @config.custom.specialtyCards}}
        <article class="specialty-card">
          <div class="specialty-icon" aria-hidden="true">{{icon}}</div>
          <h3>{{title}}</h3>
          <p>{{text}}</p>
        </article>
        {{/each}}
      </div>
    </div>
  </section>

  {{! ================= BOOKSHELF ================= }}
  <section class="bookshelf" id="bookshelf">
    <div class="container">
      <div class="section-head">
        <p class="section-eyebrow">{{ @config.custom.booksEyebrow }}</p>
        <h2>{{{ @config.custom.booksTitle }}}</h2>
        <p class="section-lead">
          {{ @config.custom.booksIntro }}
        </p>
        {{#if @config.custom.booksDiveLabel}}
        <a href="{{ @website.baseUrl }}bookshelf/" class="btn btn-ghost">{{ @config.custom.booksDiveLabel }}</a>
        {{/if}}
      </div>
    </div>
  </section>

  {{! ================= FROM THE BLOG (renders only when posts exist) ================= }}
  {{#each posts}}
    {{#if @first}}
    <section class="notes" id="notes">
      <div class="container">
        <div class="section-head">
          <p class="section-eyebrow">{{ @config.custom.blogEyebrow }}</p>
          <h2>{{ @config.custom.blogTitle }}</h2>
          <p class="section-lead">{{ @config.custom.blogLead }}</p>
        </div>
        <div class="notes-grid">
    {{/if}}
          <article class="note-card">
            {{#featuredImage}}
              {{#if url}}
              <a class="note-photo" href="{{../url}}">
                <img src="{{url}}" {{lazyload "lazy"}} alt="{{alt}}" height="{{height}}" width="{{width}}">
              </a>
              {{/if}}
            {{/featuredImage}}
            <div class="note-body">
              <h3><a href="{{url}}">{{title}}</a></h3>
              <p>{{{excerpt}}}</p>
              <p class="note-meta"><time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">{{date createdAt}}</time></p>
            </div>
          </article>
    {{#if @last}}
        </div>
      </div>
    </section>
    {{/if}}
  {{/each}}

  {{! ================= FAQ ================= }}
  <section class="faq" id="faq">
    <div class="container faq-layout">
      <div class="faq-aside">
        <p class="section-eyebrow">{{ @config.custom.faqEyebrow }}</p>
        <h2>{{ @config.custom.faqTitle }}</h2>
        <p>{{ @config.custom.faqIntro }}</p>
        <a href="{{ @website.baseUrl }}#contact" class="btn btn-primary">{{ @config.custom.faqAsideBtnLabel }}</a>
      </div>
      <div class="faq-list">
        {{#each @config.custom.faqItems}}
        <details class="faq-item"{{#if @first}} open{{/if}}>
          <summary><span>{{question}}</span><span class="faq-icon" aria-hidden="true"></span></summary>
          <div class="faq-body"><p>{{answer}}</p></div>
        </details>
        {{/each}}
      </div>
    </div>
  </section>

  {{! ================= CLOSING CTA ================= }}
  <section class="closing">
    <div class="container closing-inner">
      <div class="closing-deco" aria-hidden="true">
        <svg viewBox="0 0 200 200" width="120" height="120"><path d="M100 190C40 150 10 110 10 60 50 70 90 110 100 190zM100 190C160 150 190 110 190 60 150 70 110 110 100 190z" fill="rgba(247,244,237,0.25)"/></svg>
      </div>
      <p class="section-eyebrow eyebrow-light">{{ @config.custom.closingEyebrow }}</p>
      <h2>{{{ @config.custom.closingTitle }}}</h2>
      <p>{{ @config.custom.closingText }}</p>
      <a href="{{ @website.baseUrl }}#contact" class="btn btn-cream">{{ @config.custom.closingBtnLabel }}</a>
    </div>
  </section>

  {{! ================= CONTACT ================= }}
  <section class="contact" id="contact">
    <div {{#if @config.custom.contactEmbed}}class="container contact-grid"{{else}}class="container"{{/if}}>
      <div class="contact-info">
        <p class="section-eyebrow eyebrow-light">{{ @config.custom.contactEyebrow }}</p>
        <h2>{{ @config.custom.contactTitle }}</h2>
        <p>{{ @config.custom.contactText }}</p>

        <ul class="contact-details">
          <li>
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M3 6l9 7 9-7M3 6v12h18V6M3 6h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div><span class="contact-label">{{ @config.custom.contactEmailLabel }}</span><a href="mailto:{{ @config.custom.contactEmail }}">{{ @config.custom.contactEmail }}</a></div>
          </li>
          <li>
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M12 21s-7-5-7-11a7 7 0 0 1 14 0c0 6-7 11-7 11z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.8"/></svg>
            </span>
            <div><span class="contact-label">{{ @config.custom.contactServingLabel }}</span><span>{{ @config.custom.contactServing }}</span></div>
          </li>
          <li>
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div><span class="contact-label">{{ @config.custom.contactHoursLabel }}</span><span>{{ @config.custom.contactHours }}</span></div>
          </li>
        </ul>
      </div>

      {{#if @config.custom.contactEmbed}}
      <div class="contact-embed">
        {{{ @config.custom.contactEmbed }}}
      </div>
      {{/if}}
    </div>
  </section>

</main>

{{> footer}}
