{{!
  Homepage — renders the "Home" page (WYSIWYG body) at the site root.
  Create a page with the 'useAsFrontpage' page option set to "Enabled"
  (the seeded Home page has it on) and edit everything in the page editor.
  The "From the blog" section below the content appears once posts exist.
}}
{{> head}}
{{> header}}

<main id="main">
  {{#getPagesByCustomFields "count=1&customField=useAsFrontpage&customFieldValue=on"}}
    {{{text}}}
  {{/getPagesByCustomFields}}

  {{! ================= FROM THE BLOG (renders only when posts exist) ================= }}
  {{#each posts}}
    {{#if @first}}
    <section class="notes" id="notes">
      <div class="container">
        <div class="section-head">
          <p class="section-eyebrow">{{ @config.custom.blogEyebrow }}</p>
          <h2>{{ @config.custom.blogTitle }}</h2>
          <p class="section-lead">{{ @config.custom.blogLead }}</p>
        </div>
        <div class="notes-grid">
    {{/if}}
          <article class="note-card">
            {{#featuredImage}}
              {{#if url}}
              <a class="note-photo" href="{{../url}}">
                <img src="{{url}}" {{lazyload "lazy"}} alt="{{alt}}" height="{{height}}" width="{{width}}">
              </a>
              {{/if}}
            {{/featuredImage}}
            <div class="note-body">
              <h3><a href="{{url}}">{{title}}</a></h3>
              <p>{{{excerpt}}}</p>
              <p class="note-meta"><time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">{{date createdAt}}</time></p>
            </div>
          </article>
    {{#if @last}}
        </div>
      </div>
    </section>
    {{/if}}
  {{/each}}
</main>

{{> footer}}
