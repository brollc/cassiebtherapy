        {
            "name": "aboutP1",
            "label": "Homepage bio (paragraph 1)",
            "group": "About",
            "value": "I'm Cassie, a licensed therapist who is endlessly curious about people, relationships, and what makes us who we are. My work is grounded in the belief that our experiences and relationships shape how we see ourselves and move through the world. I'm particularly interested in helping individuals and couples better understand those patterns, make room for the parts of themselves they may have learned to hide, and build deeper, more meaningful connections.",
            "type": "textarea"
        },
        {
            "name": "aboutP2",
            "label": "Homepage bio (paragraph 2)",
            "group": "About",
            "value": "I believe therapy can hold both depth and lightness. It's a place for honesty, vulnerability, and sometimes a little laughter, too. My approach is thoughtful, relational, and collaborative, with room for curiosity, compassion, and the complexities of being human.",
            "type": "textarea"
        },
        {
            "name": "aboutGlad",
