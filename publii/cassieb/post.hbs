{{! Single blog post }}
{{> head}}
{{> header}}

<main id="main">
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">{{ @config.custom.blogEyebrow }}</p>
      {{#post}}
      <h1>{{title}}</h1>
      <p class="page-hero-lead post-meta"><time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">{{date createdAt}}</time></p>
      {{/post}}
    </div>
  </section>

  <section class="page-content">
    <div class="container">
      {{#post}}
      {{#featuredImage}}
        {{#if url}}
        <img src="{{url}}" {{lazyload "lazy"}} alt="{{alt}}" height="{{height}}" width="{{width}}">
        {{/if}}
      {{/featuredImage}}
      <div class="post-content">
        {{{text}}}
      </div>
      <p class="page-back"><a href="{{ @website.baseUrl }}">{{ @config.custom.backHomeLabel }}</a></p>
      {{/post}}
    </div>
  </section>
</main>

{{> footer}}
