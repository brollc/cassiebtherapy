{{!
  "Bookshelf" page template — three book sections with covers.
  Create a page in Publii with the slug 'bookshelf' and select the 'Bookshelf'
  template in the page editor. All content comes from Theme settings → Bookshelf.
}}
{{> head}}
{{> header}}

<main id="main">
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">{{ @config.custom.booksPageEyebrow }}</p>
      <h1>{{{ @config.custom.booksPageTitle }}}</h1>
      <p class="page-hero-lead">
        {{ @config.custom.booksPageLead }}
      </p>
    </div>
  </section>

  <section class="page-content">
    <div class="container wide">
      <div class="book-section">
        <h3 class="book-section-title">{{ @config.custom.booksCurrentlyTitle }}</h3>
        <div class="book-tiles">
          {{#each @config.custom.booksCurrently}}
          <div class="book-tile">
            {{#if coverUrl}}
            <img src="{{coverUrl}}" alt="{{#if coverAlt}}{{coverAlt}}{{else}}Book cover: {{title}}{{/if}}" loading="lazy">
            {{else}}
            <span class="book-cover-empty" aria-hidden="true"></span>
            {{/if}}
            {{#if title}}<p class="book-title">{{title}}</p>{{/if}}
            {{#if authorName}}<p class="book-author">{{authorName}}</p>{{/if}}
          </div>
          {{/each}}
        </div>
      </div>

      <div class="book-section">
        <h3 class="book-section-title">{{ @config.custom.booksRecommendedTitle }}</h3>
        <div class="book-tiles">
          {{#each @config.custom.booksRecommended}}
          <div class="book-tile">
            {{#if coverUrl}}
            <img src="{{coverUrl}}" alt="{{#if coverAlt}}{{coverAlt}}{{else}}Book cover: {{title}}{{/if}}" loading="lazy">
            {{else}}
            <span class="book-cover-empty" aria-hidden="true"></span>
            {{/if}}
            {{#if title}}<p class="book-title">{{title}}</p>{{/if}}
            {{#if authorName}}<p class="book-author">{{authorName}}</p>{{/if}}
          </div>
          {{/each}}
        </div>
      </div>

      <div class="book-section">
        <h3 class="book-section-title">{{ @config.custom.booksInformedTitle }}</h3>
        <div class="book-tiles">
          {{#each @config.custom.booksInformed}}
          <div class="book-tile">
            {{#if coverUrl}}
            <img src="{{coverUrl}}" alt="{{#if coverAlt}}{{coverAlt}}{{else}}Book cover: {{title}}{{/if}}" loading="lazy">
            {{else}}
            <span class="book-cover-empty" aria-hidden="true"></span>
            {{/if}}
            {{#if title}}<p class="book-title">{{title}}</p>{{/if}}
            {{#if authorName}}<p class="book-author">{{authorName}}</p>{{/if}}
          </div>
          {{/each}}
        </div>
      </div>

      <p class="page-back"><a href="{{ @website.baseUrl }}">{{ @config.custom.backHomeLabel }}</a></p>
    </div>
  </section>
</main>

{{> footer}}
