<!DOCTYPE html>
<html lang="{{ @website.language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {{#if title}}
    <title>{{title}}</title>
  {{else}}
    <title>{{ @website.name }}</title>
  {{/if}}

  {{metaDescription}}
  {{metaRobots}}
  {{canonicalLink}}
  {{feedLink}}
  {{socialMetaTags}}
  {{{publiiHead}}}
  {{jsonLD}}

  {{#if @config.custom.faviconUpload}}
    <link rel="shortcut icon" href="{{ @config.custom.faviconUpload }}" type="image/png">
  {{else}}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Ccircle cx='20' cy='20' r='18' fill='%236b8e5a'/%3E%3Cpath d='M14 26c0-6 3-10 8-12 1 5-1 9-8 12z' fill='%23f7f4ed'/%3E%3C/svg%3E">
  {{/if}}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Nunito+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{css "main.css"}}">

  {{{@headCustomCode}}}
</head>
<body>

<a href="#main" class="skip-link">Skip to main content</a>

{{{@bodyCustomCode}}}
