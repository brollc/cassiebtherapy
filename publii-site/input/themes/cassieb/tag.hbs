{{! Tag archive page }}
{{> head}}
{{> header}}

<main id="main">
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">Posts tagged</p>
      {{#tag}}
      <h1>{{name}}</h1>
      {{#if description}}
      <p class="page-hero-lead">{{{description}}}</p>
      {{/if}}
      {{/tag}}
    </div>
  </section>

  <section class="page-content">
    <div class="container wide">
      <div class="notes-grid">
        {{#each posts}}
        <article class="note-card">
          {{#featuredImage}}
            {{#if url}}
            <a class="note-photo" href="{{../url}}">
              <img src="{{url}}" {{lazyload "lazy"}} alt="{{alt}}" height="{{height}}" width="{{width}}">
            </a>
            {{/if}}
          {{/featuredImage}}
          <div class="note-body">
            <h3><a href="{{url}}">{{title}}</a></h3>
            <p>{{{excerpt}}}</p>
            <p class="note-meta"><time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">{{date createdAt}}</time></p>
          </div>
        </article>
        {{/each}}
      </div>
    </div>
  </section>
</main>

{{> footer}}
